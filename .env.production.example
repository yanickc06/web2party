# ============================================
# WEB2PARTY - PRODUCTION UMGEBUNGSVARIABLEN
# ============================================
# Diese Datei auf dem Server als .env speichern!

# MySQL Datenbank URL
# Erstelle eine Datenbank in Plesk und trage die Daten hier ein
DATABASE_URL="mysql://DEIN_DB_USER:DEIN_DB_PASSWORT@localhost:3306/DEIN_DB_NAME"

# NextAuth Secret (WICHTIG: Generiere einen neuen!)
# Generieren mit: openssl rand -base64 32
AUTH_SECRET="HIER_EINEN_LANGEN_ZUFAELLIGEN_STRING_EINTRAGEN"

# Deine Domain (WICHTIG: Anpassen!)
NEXTAUTH_URL="https://deine-domain.de"

# Node Environment
NODE_ENV="production"
