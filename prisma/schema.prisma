// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== AUTHENTIFIZIERUNG ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(USER)
  isActive      Boolean   @default(false) // Muss bestätigt werden
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // DJ Profil Felder
  djName        String?   // Künstlername
  photoUrl      String?   // Profilbild
  phone         String?   // Telefon
  website       String?   // Website
  musicStyles   String?   // Musikstile (kommagetrennt)
  experience    String?   // Erfahrung/Bio
  equipment     String?   // Eigene Ausrüstung
  socialMedia   String?   // Social Media Links (JSON)
  
  // Relations
  parties       Party[]
  files         File[]
}

enum Role {
  ADMIN
  USER
}

// ==================== KUNDENVERWALTUNG ====================

model Customer {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  street          String?
  city            String?
  postalCode      String?
  country         String?   @default("Deutschland")
  birthDate       DateTime?
  bankName        String?
  iban            String?
  bic             String?
  musicTaste      String?   // z.B. "House, Techno, 80er"
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  locations       Location[]
  parties         Party[]
  invoices        Invoice[]
}

model Location {
  id              String    @id @default(cuid())
  name            String
  street          String?
  city            String?
  postalCode      String?
  country         String?   @default("Deutschland")
  contactPerson   String?
  phone           String?
  email           String?
  capacity        Int?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  parties         Party[]
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime?
  paidDate        DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Relations
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  partyId         String?
  party           Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ==================== PARTNERVERWALTUNG ====================

model Partner {
  id              String    @id @default(cuid())
  name            String
  contactPerson   String?
  email           String?
  phone           String?
  website         String?
  benefits        String?   // Vorteile beim Partner
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  equipment       Equipment[]
}

// ==================== TECHNIKVERWALTUNG ====================

model Equipment {
  id              String          @id @default(cuid())
  name            String
  category        EquipmentCategory
  brand           String?
  model           String?
  serialNumber    String?
  location        String?         // Standort
  isOwned         Boolean         @default(true)
  rentalPrice     Decimal?        @db.Decimal(10, 2)
  purchasePrice   Decimal?        @db.Decimal(10, 2)
  purchaseDate    DateTime?
  specs           String?         // Technische Daten
  notes           String?
  imageUrl        String?         // Bild-URL
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations (Partner für Miete)
  rentalPartnerId String?
  rentalPartner   Partner?        @relation(fields: [rentalPartnerId], references: [id], onDelete: SetNull)
  partyEquipment  PartyEquipment[]
}

enum EquipmentCategory {
  SPEAKER
  MIXER
  CONTROLLER
  LIGHTS
  MICROPHONE
  CABLES
  STAND
  EFFECTS
  OTHER
}

// ==================== MUSIKVERWALTUNG ====================

model Song {
  id              String    @id @default(cuid())
  title           String
  artist          String
  album           String?
  bpm             Int?
  key             String?   // Tonart
  genre           String?
  mood            String?   // Stimmung
  duration        Int?      // Dauer in Sekunden
  year            Int?
  mp3Path         String?   // Pfad zur MP3-Datei
  hasMp3          Boolean   @default(false)
  tags            String?   // Komma-separierte Tags (z.B. "Opener,Peak Time")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  playlistSongs   PlaylistSong[]
  cuePoints       CuePoint[]
}

// Cue-Points für Songs (Intro, Drop, Outro, etc.)
model CuePoint {
  id              String    @id @default(cuid())
  name            String    // z.B. "Intro", "Drop", "Breakdown", "Outro"
  time            Float     // Zeit in Sekunden
  color           String?   // Farbe für UI (z.B. "#ff0000")
  createdAt       DateTime  @default(now())
  
  // Relations
  songId          String
  song            Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  
  @@index([songId])
}

model Playlist {
  id              String    @id @default(cuid())
  name            String
  description     String?
  isSmartPlaylist Boolean   @default(false)  // Ist dies eine Smart-Playlist?
  smartCriteria   String?   @db.Text          // JSON mit Smart-Playlist Kriterien
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  songs           PlaylistSong[]
  parties         Party[]
}

model PlaylistSong {
  id              String    @id @default(cuid())
  position        Int       // Reihenfolge in der Playlist
  
  // Relations
  playlistId      String
  playlist        Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  songId          String
  song            Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  
  @@unique([playlistId, songId])
}

// ==================== DATEIMANAGER ====================

model Folder {
  id              String    @id @default(cuid())
  name            String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Self-relation für verschachtelte Ordner
  parentId        String?
  parent          Folder?   @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children        Folder[]  @relation("FolderToFolder")
  
  // Relations
  files           File[]
}

model File {
  id              String    @id @default(cuid())
  name            String
  originalName    String
  mimeType        String
  size            Int       // Größe in Bytes
  path            String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  folderId        String?
  folder          Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedById    String?
  uploadedBy      User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

// ==================== PARTYMANAGER ====================

model Party {
  id              String      @id @default(cuid())
  name            String
  date            DateTime
  startTime       String?
  endTime         String?
  status          PartyStatus @default(INQUIRY)
  guestCount      Int?
  price           Decimal?    @db.Decimal(10, 2)
  deposit         Decimal?    @db.Decimal(10, 2)
  depositPaid     Boolean     @default(false)
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Relations
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  locationId      String?
  location        Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  playlistId      String?
  playlist        Playlist?   @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  equipment       PartyEquipment[]
  invoices        Invoice[]
  musicRequests   MusicRequest[]
  requestCode     String?     @unique  // Einzigartiger Code für Musikwünsche
  timelineEntries PartyTimelineEntry[]
  checklistItems  PartyChecklistItem[]
  partyNotes      PartyNote[]
  playedSongs     PlayedSong[]
}

// Timeline-Einträge für DJ-Set Zeitplan
model PartyTimelineEntry {
  id              String    @id @default(cuid())
  time            String    // z.B. "22:00"
  description     String    // z.B. "Opening Set starten"
  songId          String?   // Optional: Verknüpfter Song
  completed       Boolean   @default(false)
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  
  // Relations
  partyId         String
  party           Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  
  @@index([partyId])
}

// Checkliste für Party-Vorbereitung
model PartyChecklistItem {
  id              String    @id @default(cuid())
  title           String    // z.B. "Vertrag unterschrieben"
  category        String?   // z.B. "Vorbereitung", "Equipment", "Musik"
  checked         Boolean   @default(false)
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  
  // Relations
  partyId         String
  party           Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  
  @@index([partyId])
}

// Erweiterte Notizen mit Kategorien
model PartyNote {
  id              String    @id @default(cuid())
  content         String    @db.Text
  category        NoteCategory @default(GENERAL)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  partyId         String
  party           Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  
  @@index([partyId])
}

enum NoteCategory {
  GENERAL       // Allgemein
  WISHES        // Kundenwünsche
  FORBIDDEN     // Verbotene Songs
  HIGHLIGHTS    // Highlights
  FEEDBACK      // Feedback nach Event
}

// Gespielte Songs während einer Party (für Statistiken)
model PlayedSong {
  id              String      @id @default(cuid())
  title           String
  artist          String?
  playedAt        DateTime    @default(now())
  reaction        SongReaction? // Publikumsreaktion
  notes           String?
  
  // Relations
  partyId         String
  party           Party       @relation(fields: [partyId], references: [id], onDelete: Cascade)
  songId          String?     // Optional: Verknüpfung mit Song aus Bibliothek
  
  @@index([partyId])
}

enum SongReaction {
  AMAZING       // 🔥 Tanzfläche voll
  GOOD          // 👍 Gut angekommen
  NEUTRAL       // 😐 Normal
  BAD           // 👎 Wenig Resonanz
}

enum PartyStatus {
  INQUIRY
  CONFIRMED
  COMPLETED
  CANCELLED
}

model PartyEquipment {
  id              String    @id @default(cuid())
  quantity        Int       @default(1)
  packed          Boolean   @default(false)
  notes           String?
  
  // Relations
  partyId         String
  party           Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  
  @@unique([partyId, equipmentId])
}

// ==================== MUSIKWÜNSCHE ====================

model MusicRequest {
  id              String    @id @default(cuid())
  songTitle       String
  artist          String?
  guestName       String?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime  @default(now())
  
  // Relations
  partyId         String
  party           Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

enum RequestStatus {
  PENDING
  PLAYED
  DECLINED
}
